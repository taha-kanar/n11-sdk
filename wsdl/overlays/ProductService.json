      { "name": "displayPrice", "type": "decimal", "evidence": "ProductBasic.displayPrice", "sample": "791.44" },
      { "name": "optionPrice", "type": "decimal", "evidence": "ProductSkuRequest.optionPrice", "sample": "791.44" },
      { "name": "n11CatalogId", "type": "long", "evidence": "ProductSkuRequest.n11CatalogId", "sample": "281771404" },
      { "name": "sellerStockCode", "type": "string", "evidence": "ProductSkuRequest.sellerStockCode", "sample": "EDT-K71-1000" },
      { "name": "attributes", "type": "ProductAttributeList", "evidence": "observed", "sample": "<attribute><id>354080385</id><name>Marka</name><value>Kimyasitesi</value></attribute> — exactly ProductAttribute" },
      { "name": "id", "type": "long", "evidence": "ProductSkuList.id", "sample": "127371500417" },
      { "name": "images", "type": "ProductImageList", "evidence": "observed", "sample": "<image><order>1</order><url>https://…jpg</url></image> — exactly ProductImage" },
      { "name": "quantity", "type": "int", "evidence": "ProductSkuRequest.quantity", "sample": "10" },
